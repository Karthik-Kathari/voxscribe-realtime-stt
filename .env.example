PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
